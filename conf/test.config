/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    Bundled test data (assets/test_data/human_chr21/) is a real chr21-only subset:
    reference fasta, GTF, circRNA DB, liftover chain, and a fastq of reads whose origin
    circRNA falls on chr21 -- small enough to run in minutes, but exercises the full
    4-tool + crossrun-merge + quantify DAG against real (not synthetic) data.

    Use as follows:
        nextflow run . -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal chr21-only dataset to check pipeline installation and function'

    // generate samplesheet with absolute fastq path (relative paths not portable here)
    input                     = {
        def dir = "${projectDir}/assets/test_data/human_chr21"
        def f = new File(System.getProperty('java.io.tmpdir') ?: '/tmp', 'nanocirc_test_samplesheet.csv')
        f.text = "sample,fastq,group\nchr21_test,${dir}/chr21_run1.fastq.gz,human\n"
        f.toString()
    }()
    fasta                     = "${projectDir}/assets/test_data/human_chr21/chr21.fa"
    gtf                       = "${projectDir}/assets/test_data/human_chr21/chr21.gtf"
    circrna_db                = "${projectDir}/assets/test_data/human_chr21/chr21_circrna_db.bed"
    circnick_liftover_chain   = "${projectDir}/assets/test_data/human_chr21/hg19ToHg38.over.chain.gz"
    circnick_species          = 'human'

    run_isocirc               = true
    run_circfl                = true
    run_circnick              = true
    run_cirilong              = true
    run_crossrun_merge        = false
    run_quantify              = true
}
