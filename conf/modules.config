/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // ── QC modules ────────────────────────────────────────────────────────────

    withName: FASTQC {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOPLOT {
        ext.args   = '--plots dot'
        publishDir = [
            path: { "${params.outdir}/qc/${meta.id}/nanoplot" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── Genome preparation ────────────────────────────────────────────────────

    withName: PREPARE_GENOME {
        publishDir = [
            enabled: false
        ]
    }

    // ── Tool raw outputs ──────────────────────────────────────────────────────

    withName: ISOCIRC {
        memory     = { 100.GB * task.attempt }
        maxRetries = 2
        publishDir = [
            [
                path: { "${params.outdir}/circrna/${meta.id}/isocirc" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/circrna/${meta.id}/bed12" },
                mode: params.publish_dir_mode,
                pattern: "**/*.bed"
            ]
        ]
    }

    withName: CIRCFL_SEQ {
        cpus       = { 12 }
        time       = { 72.h * task.attempt }   
        publishDir = [
            [
                path: { "${params.outdir}/circrna/${meta.id}/circfl_seq" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/circrna/${meta.id}/bed12" },
                mode: params.publish_dir_mode,
                pattern: "**/circFL_final.bed"
            ]
        ]
    }

    withName: CIRI_LONG {
        // Long-read circRNA calling is slow on large human datasets (>24 h per sample).
        // Give generous time with 2 retries so transient OOM/walltime kills recover.
        time       = { 48.h  * task.attempt }
        memory     = { 200.GB * task.attempt }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/ciri_long" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CIRCNICK_LRS {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/circnick_lrs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CIRCNICK_LIFTOVER {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/circnick_lrs/lifted" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── BED12 conversions ─────────────────────────────────────────────────────

    withName: CIRILONG_TO_BED12 {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/bed12" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CIRCNICK_TO_BED12 {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/bed12" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── Merged outputs ────────────────────────────────────────────────────────

    withName: CIRCRNA_BEDTOOLS_PAIRS {
        publishDir = [ enabled: false ]
    }

    withName: CIRCRNA_MERGE {
        publishDir = [
            [
                path: { "${params.outdir}/circrna/${meta.id}/merged/strict" },
                mode: params.publish_dir_mode,
                pattern: "*strict*",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/circrna/${meta.id}/merged/relaxed" },
                mode: params.publish_dir_mode,
                pattern: "*relaxed*",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: CIRCRNA_EXON_MERGE {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged/exon_based" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CIRCRNA_SMART_MERGE {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // params.run_benchmark_modes may be the CLI-supplied String
                // "false", which is truthy in Groovy, so it must be coerced
                // here rather than checked directly.
                def runBenchmarkModes = params.run_benchmark_modes instanceof String
                    ? params.run_benchmark_modes.toBoolean() : (params.run_benchmark_modes as boolean)
                if (!runBenchmarkModes &&
                    (filename.contains('smart_consensus') || filename.contains('priority'))) return null
                return filename
            }
        ]
    }

    withName: 'CIRCRNA_FILTER_BALANCED' {
        ext.args   = 'isocirc_only'
        ext.prefix = { "${meta.id}_balanced_precision" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_HIGH_CONFIDENCE' {
        ext.args   = 'high_only_isocirc'
        ext.prefix = { "${meta.id}_high_confidence" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Balanced (recall): consensus algorithm + trusted_only filter, default pipeline tier
    withName: 'CIRCRNA_FILTER_CONSENSUS_TRUSTED' {
        ext.args   = 'trusted_only'
        ext.prefix = { "${meta.id}_balanced_recall" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Benchmark-mode filter variants (--run_benchmark_modes)
    withName: 'CIRCRNA_FILTER_CONSENSUS_NO_LOW' {
        ext.args   = 'no_low'
        ext.prefix = { "${meta.id}_smart_consensus_no_low" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_XSTRUCT_NO_LOW' {
        ext.args   = 'no_low'
        ext.prefix = { "${meta.id}_smart_consensus_xstruct_no_low" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_XSTRUCT_TRUSTED' {
        ext.args   = 'trusted_only'
        ext.prefix = { "${meta.id}_smart_consensus_xstruct_filtered" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_XSTRUCT_HIGH_ONLY' {
        ext.args   = 'high_only'
        ext.prefix = { "${meta.id}_smart_consensus_xstruct_high_only" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_PRIORITY_NO_LOW' {
        ext.args   = 'no_low'
        ext.prefix = { "${meta.id}_smart_priority_no_low" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_PRIORITY_TRUSTED' {
        ext.args   = 'trusted_only'
        ext.prefix = { "${meta.id}_smart_priority_filtered" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FILTER_PRIORITY_HIGH_ONLY' {
        ext.args   = 'high_only'
        ext.prefix = { "${meta.id}_smart_priority_high_only" }
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── Cross-sample merge ────────────────────────────────────────────────────

    withName: CIRCRNA_CROSSRUN_MERGE {
        publishDir = [
            path: { "${params.outdir}/circrna/crossrun/${meta.id}/${meta.tier}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ── Functional annotation ─────────────────────────────────────────────────

    withName: 'NANOCIRC:CIRCRNA_ANALYSIS:CIRCRNA_ANNOTATE:SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }

    withName: 'NANOCIRC:CIRCRNA_ANALYSIS:CIRCRNA_ANNOTATE:AGAT_CONVERTBED2GFF' {
        ext.args   = { "--primary_tag transcript --source ${meta.category}" }
        ext.prefix = { "${meta.id}_${meta.category}" }
        publishDir = [
            path: {
                // Legacy benchmark-only categories (strict/relaxed/exon_based) keep their
                // own subfolder; every other (default-pipeline) category publishes directly
                // under merged/, with no extra nesting.
                def dir = meta.category.startsWith('strict')  ? 'strict/'
                        : meta.category.startsWith('relaxed') ? 'relaxed/'
                        : meta.category.startsWith('exon')    ? 'exon_based/'
                        : ''
                "${params.outdir}/circrna/${meta.id}/merged/${dir}gff"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NANOCIRC:CIRCRNA_ANALYSIS:CIRCRNA_ANNOTATE:GFFCOMPARE' {
        ext.prefix = { "${meta.id}_${meta.category}" }
        publishDir = [
            path: {
                def dir = meta.category.startsWith('strict')  ? 'strict/'
                        : meta.category.startsWith('relaxed') ? 'relaxed/'
                        : meta.category.startsWith('exon')    ? 'exon_based/'
                        : ''
                "${params.outdir}/circrna/${meta.id}/merged/${dir}gff"
            },
            mode: params.publish_dir_mode,
            // Publish only the .tmap and .stats. tracking/loci/annotated.gtf are internal
            pattern: "*.{tmap,stats}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NANOCIRC:CIRCRNA_ANALYSIS:CIRCRNA_ANNOTATE:GFFREAD' {
        // -w: write spliced exon sequences (FASTA) of each transcript
        ext.args   = '-w'
        ext.prefix = { "${meta.id}_${meta.category}" }
        publishDir = [
            path: {
                def dir = meta.category.startsWith('strict')  ? 'strict/'
                        : meta.category.startsWith('relaxed') ? 'relaxed/'
                        : meta.category.startsWith('exon')    ? 'exon_based/'
                        : ''
                "${params.outdir}/circrna/${meta.id}/merged/${dir}fasta"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NANOCIRC:CIRCRNA_ANALYSIS:CIRCRNA_ANNOTATE:ADD_CLASS_CODES' {
        ext.prefix = { "${meta.id}_${meta.category}" }
        publishDir = [
            path: {
                def dir = meta.category.startsWith('strict')  ? 'strict/'
                        : meta.category.startsWith('relaxed') ? 'relaxed/'
                        : meta.category.startsWith('exon')    ? 'exon_based/'
                        : ''
                "${params.outdir}/circrna/${meta.id}/merged/${dir}annotated"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CIRCRNA_FINALIZE' {
        publishDir = [
            path: {
                def dir = meta.category.startsWith('strict')  ? 'strict/'
                        : meta.category.startsWith('relaxed') ? 'relaxed/'
                        : meta.category.startsWith('exon')    ? 'exon_based/'
                        : ''
                "${params.outdir}/circrna/${meta.id}/merged/${dir}clean"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GTF_TO_FEATURE_BED' {
        publishDir = [ enabled: false ]
    }

    // ── Quantification (--run_quantify) ──────────────────────────────────────
    // Only the final per-sample quant TSV is published; every intermediate
    // (circle references, chunk references, genome BAM, similarity DB,
    // per-tier raw counts) stays in the work directory.
    withName: 'QUANT_GENOME_INDEX|QUANT_PREPARE_CATALOG|QUANT_TIER1|QUANT_COVERAGE_FLAG' {
        publishDir = [ enabled: false ]
    }

    withName: 'QUANT_TIERED_RESCUE' {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/quantify" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Enriched clean TSVs (clean.tsv + quant counts) published alongside the
    // existing clean.tsv, not under quantify/. Same categories, same directory.
    withName: 'QUANT_APPEND_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/circrna/${meta.id}/merged/clean" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // Runs for discovery/balanced_recall/high_confidence (see workflows/nanocirc.nf).
    withName: 'FILTER_CONFIDENT_DISCOVERY' {
        publishDir = [
            [
                path: { "${params.outdir}/circrna/${meta.id}/merged/clean" },
                mode: params.publish_dir_mode,
                pattern: "*_clean_with_counts.tsv",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/circrna/${meta.id}/merged" },
                mode: params.publish_dir_mode,
                pattern: "*.bed12"
            ]
        ]
    }

    // One wide sample x isoform count matrix per tier, all samples in this run.
    withName: 'BUILD_DESEQ2_MATRIX' {
        publishDir = [
            path: { "${params.outdir}/circrna/deseq2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
