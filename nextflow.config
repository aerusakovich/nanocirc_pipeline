/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nanocirc Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false
    fasta                      = null    // reference genome FASTA (overridden by --genome if iGenomes)
    gtf                        = null    // gene annotation GTF
    circrna_db                 = null    // circRNA database BED (for isocirc + ciri-long)
    genome_index_dir           = null    // if null → <outdir>/genome_index

    // Wet-lab protocol preset: ciri_long, circfl, isocirc, or circnick.
    // CLI --run_* still overrides the preset (see Tool selection below).
    wet_lab                    = null

    // Tool selection. --wet_lab circnick runs CircNick-LRS alone. --wet_lab
    // isocirc defaults CIRI-long off: on real isoCirc-protocol data it has
    // hung for 24+ days without finishing, and dropping it costs only
    // ~0.01 F1 (benchmarked). --run_cirilong true overrides this back on.
    run_isocirc                = params.wet_lab == 'circnick' ? false : true
    run_circfl                 = params.wet_lab == 'circnick' ? false : true
    run_cirilong               = (params.wet_lab == 'circnick' || params.wet_lab == 'isocirc') ? false : true
    run_circnick               = true

    // circnick-lrs options
    circnick_species           = null    // required when run_circnick=true: 'mouse' or 'human'
    circnick_liftover_chain    = null    // path to UCSC .chain file if genome build differs

    // Extra native CLI args, passed through unmodified. Empty by default.
    // CIRI-long and circnick-lrs have no user-facing detection-tuning flags
    // (verified against their own --help), so there is nothing to expose there.
    isocirc_args               = ''    // appended to the isocirc command
    // circfl_args: only '-u' and '-m <rmsk>' are accepted (validated in
    // workflows/nanocirc.nf). Every other circfull flag is a hardcoded I/O
    // path shared across RG/DNSC/cRG/mRG and would break that chain.
    circfl_args                = ''

    // Merge behaviour
    circrna_bsj_tolerance      = 5       // bp tolerance for relaxed BSJ grouping
    circrna_isoform_overlap    = 0.95    // min reciprocal spliced-length overlap

    // balanced's trusted_only filter: tools whose Low-confidence
    // single-tool calls still get rescued.
    circrna_trusted_tools      = 'cirilong,isocirc,circfl'

    // Cross-run merge (CIRCRNA_CROSSRUN_MERGE) structure-vote corroboration:
    // a structure backed by only 1 run is dropped unless that run's own
    // tool-agreement (struct_agree_count) meets this bar; structures backed
    // by >=2 runs are never dropped by this check.
    crossrun_min_tool_agreement = 2

    // Discovery/balanced confidence filter (post-quantification): drops
    // CircNick-LRS-only loci at or below this many quantified reads.
    circrna_confident_min_reads = 2

    // Cross-sample merging (requires 'group' column in samplesheet)
    run_crossrun_merge      = false   // merge circRNA calls across samples sharing a group

    // Quantification (per-sample, against each sample's own discovery catalog)
    run_quantify               = false   // enable remap-based circRNA read quantification
    quant_chunk_size           = 100     // loci per reference chunk for tier1 chunked remap
    quant_chunk_seed           = 42      // fixed shuffle seed for chunk assignment (reproducibility)
    quant_locus_dedup_tolerance = 10     // bp tolerance (both start AND end) for near-duplicate locus dedup
    quant_min_old_tool_count   = 50      // min independent old-tool-count to flag a locus for tier2 rescue

    // Output mode selection (hidden/advanced)
    run_benchmark_modes        = false   // also publish all research variants (legacy merge + smart-merge variants)

    // QC options
    skip_qc                    = false
    skip_nanoplot              = false
    skip_fastqc                = false
    skip_multiqc               = false

    // Annotation options
    skip_annotation            = false  // set true to skip GFF/FASTA/annotated TSV generation

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = System.getenv('HOOK_URL')
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // arm64 requires Wave (see https://github.com/nf-core/modules/issues/6694)
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.ociAutoPull = true   // build SIF on compute node (uses task memory), not on orchestrator
        singularity.pullTimeout = '4h'   // large images (e.g. CircNick 2.7 GB) need >60 min on slow registries
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.pullTimeout   = '4h'   // large images (e.g. CircNick 2.7 GB) need >60 min on slow registries
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// load nf-core institutional profiles (skipped if offline and no local base path)
includeConfig ({
    params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http'))
        ? "${params.custom_config_base}/nfcore_custom.config"
        : "/dev/null"
}())


// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Pull SIF images on compute nodes, not in the orchestrator, to avoid concurrent OOM
singularity.ociAutoPull = true
apptainer.ociAutoPull   = true

// Load igenomes.config if required
includeConfig ({ !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config' }())

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    MPLCONFIGDIR     = "/tmp"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'aerusakovich/nanocirc_pipeline'
    contributors    = [
        [
            name: 'Rusakovich Anastasia',
            affiliation: '',
            email: 'anastasiia.rusakovich@gmail.com',
            github: '',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/aerusakovich/nanocirc_pipeline'
    description     = """circRNA detection and analysis pipeline for long-read circRNA analysis"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
